{
  "name": "next-a2ui",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "eval": "bun run packages/eval/src/cli.ts",
    "verify": "bun run catalog && bun run typecheck && bun run lint && bun test && bun run eval",
    "smoke": "bun run scripts/smoke.tsx",
    "catalog": "bun run scripts/build-catalog.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@next-a2ui/core": "workspace:*",
    "@next-a2ui/llm": "workspace:*",
    "@next-a2ui/eval": "workspace:*",
    "@next-a2ui/adapter": "workspace:*",
    "@next-a2ui/runtime": "workspace:*",
    "@next-a2ui/movie": "workspace:*",
    "react-dom": "^19.2.0",
    "react": "^19.2.0",
    "@next-a2ui/contract": "workspace:*"
  }
}
